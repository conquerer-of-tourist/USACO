#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n, m;
    cin >> n >> m;
    set<int> values;
    for (int i = 0; i < n; i++) {
        int a;
        cin >> a;
        values.insert(a);
    }
    int answer = 0;
    for (int i = 0; i < m; i++) {
        int a;
        cin >> a;
        if (values.count(a)) answer++;
    }
    cout << answer << '\n';
}